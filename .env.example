# Local PostgreSQL lab database. The example password is only for the disposable
# container in compose.yaml; replace it outside an isolated development machine.
SDN_DB_ENABLED=true
SDN_PG_HOST=127.0.0.1
SDN_PG_PORT=5432
SDN_PG_DB=sdn_monitor
SDN_PG_USER=sdn_user
SDN_PG_PASSWORD=local-lab-only
SDN_PG_CONNECT_TIMEOUT=5
SDN_DB_FLUSH_EVERY=100

# Controller monitoring and inference.
SDN_POLL_INTERVAL=5
SDN_DDOS_SERVICE_URL=http://127.0.0.1:8000/predict
SDN_DDOS_API_KEY=replace-with-a-random-local-key
SDN_DDOS_THRESHOLD=0.80
SDN_FLOW_IDLE_TIMEOUT=60

# Mitigation is opt-in. Only addresses in these private lab networks may be
# blocked by the controller or targeted by the controlled experiment launcher.
SDN_MITIGATION_ENABLED=false
SDN_BLOCK_SECONDS=300
SDN_ALLOWED_TARGET_CIDRS=10.0.0.0/8

# The service starts in not_ready state until a project-owned model and its
# independently calculated SHA-256 checksum are supplied.
DDOS_API_KEY=replace-with-the-same-random-local-key
DDOS_MODEL_PATH=
DDOS_MODEL_SHA256=
DDOS_MAX_BATCH_SIZE=500
DDOS_HOST=127.0.0.1
DDOS_PORT=8000
