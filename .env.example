# Local PostgreSQL lab database. The example password is only for the disposable
# container in compose.yaml; replace it outside an isolated development machine.
SDN_DB_ENABLED=true
SDN_PG_HOST=127.0.0.1
SDN_PG_PORT=5432
SDN_PG_DB=sdn_monitor
SDN_PG_USER=sdn_user
SDN_PG_PASSWORD=local-lab-only
SDN_PG_CONNECT_TIMEOUT=5
SDN_DB_FLUSH_EVERY=100

# Controller monitoring and inference.
# Seconds between statistics polls; 1-2 s reacts sooner (see docs/detection-modes.md).
SDN_POLL_INTERVAL=5
SDN_DDOS_SERVICE_URL=http://127.0.0.1:8000/predict
SDN_DDOS_API_KEY=replace-with-a-random-local-key
SDN_DDOS_THRESHOLD=0.80
SDN_FLOW_IDLE_TIMEOUT=60

# Mitigation is opt-in. Only addresses in these private lab networks may be
# blocked by the controller or targeted by the controlled experiment launcher.
SDN_MITIGATION_ENABLED=false
SDN_BLOCK_SECONDS=300
SDN_ALLOWED_TARGET_CIDRS=10.0.0.0/8

# The service starts in not_ready state until a project-owned model and its
# independently calculated SHA-256 checksum are supplied.
DDOS_API_KEY=replace-with-the-same-random-local-key
DDOS_MODEL_PATH=
DDOS_MODEL_SHA256=
DDOS_MAX_BATCH_SIZE=500
DDOS_HOST=127.0.0.1
DDOS_PORT=8000

# Optional Linux container workspace. Credentials are generated separately by
# make lab-setup in ignored .lab/env; never expose them or the runner remotely.
SDN_LAB_DB_NETWORK=sdn-ddos-detection-response_default
SDN_LAB_PG_HOST=postgres
# Container path, not a workstation path. The models directory is read-only.
SDN_LAB_MODEL_PATH=

# Optional detector container (compose.detector.yaml, scripts/lab_detector.sh).
# Mode, model, prompt and response policy can also be changed at runtime with
# scripts/detector.sh; see docs/detection-modes.md. Mitigation stays opt-in per run.
SDN_DETECTION_MODE=llm
SDN_LLM_OLLAMA_URL=http://192.168.83.1:11434
SDN_LLM_MODEL=llama3.2:3b
SDN_LLM_PROMPT=lab
SDN_LLM_MAX_SAMPLES=5
# Judge flows on a separate greenthread so packet-ins are never stalled by the model.
SDN_LLM_ASYNC=true
SDN_LLM_CACHE_SIZE=4096
SDN_ENTROPY_K=2.5
SDN_ENTROPY_WARMUP=16
SDN_ENTROPY_CONSECUTIVE=2
SDN_ENTROPY_WINDOW_SECONDS=5
SDN_ENTROPY_CANDIDATE_MIN_RATE=20
# Optional entropy tuning (defaults keep the original behaviour):
# SDN_ENTROPY_WINDOW_MODE=mean       # mean (default in the lab) | snapshot (last poll only)
# SDN_ENTROPY_DEDUPE_SWITCHES=false  # count a flow once even if several switches report it
# SDN_ENTROPY_UPDATE_HOLD=0          # windows a normal-looking window waits before updating the band
# SDN_ENTROPY_ALPHA_RUN=             # slower smoothing after the warmup (e.g. 0.05)
# Which entropy and how its normal band is learned (docs/detection-modes.md):
# SDN_ENTROPY_MEASURE=shannon        # shannon | norm | renyi | tsallis | min
# SDN_ENTROPY_ORDER=2                # order of renyi / tsallis
# SDN_ENTROPY_CENTER=ewma            # ewma | mean | median | yu (Yu et al. 2024)
# SDN_ENTROPY_SPREAD=std             # std | mad (mean/median only)
# SDN_ENTROPY_HISTORY=0              # windows remembered by mean/median/yu (0 = the whole run)
# SDN_ENTROPY_CONTEXT=normal         # normal: learn only normal-looking windows | all: learn every window
# SDN_ENTROPY_FEATURES=src,dst       # add dport and/or proto to also watch ports and protocols
SDN_RESPONSE_POLICY=block
SDN_RESPONSE_DRY_RUN=true
SDN_RATE_LIMIT_PPS=50
SDN_RATE_LIMIT_SECONDS=120
SDN_RESPONSE_ESCALATE_AFTER=20
SDN_RESPONSE_PROTECTED=
SDN_RESPONSE_MAX_ACTIVE=16
# Act only after a source was flagged this many times (in different polls) within
# CONFIRM_SECONDS; 1 acts on the first detection. A model's one-off false alarm on a
# quiet legitimate client is then never blocked.
SDN_RESPONSE_CONFIRM_HITS=1
SDN_RESPONSE_CONFIRM_SECONDS=30
