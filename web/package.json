{
  "name": "sdn-lab-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:unit && playwright test",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format-check": "prettier --check src tests *.ts *.json index.html",
    "test:unit": "node --experimental-strip-types --test tests/detection.unit.ts tests/traffic.unit.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "echarts": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
